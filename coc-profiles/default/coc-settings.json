  "path.relativeToCwd": true,
  "suggest.enablePreselect": false,
  "suggest.noselect": false,
  "suggest.completionItemKindLabels": {
    "file": "F",
    "path": "P"
  },
  "yaml.customTags": [
    "!Ref scalar",
    "!Sub scalar",
    "!GetAtt",
    "!Base64",
    "!FindInMap",
    "!GetAZs",
    "!ImportValue",
    "!Join",
    "!Select",
    "!Split",
    "!If",
    "!Equals",
    "!Equals mapping",
    "!Not",
    "!And",
    "!Or",
    "!Condition"
  ],
  "yaml.format.enable": true,
  "yaml.hover": true,
  "yaml.completion": true
