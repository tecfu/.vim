" Config for builtin langservers
Plug 'neovim/nvim-lspconfig'
Plug 'hrsh7th/cmp-nvim-lsp'

function! SetupLspBuiltin()
  lua << EOF
-- 1. Setup Logging
local log_level = tonumber(vim.env.VIM_LOG_LEVEL or "0")
if log_level >= 3 then vim.lsp.set_log_level('trace') end

local function debug_log(msg)
  if log_level >= 3 then
    vim.cmd('echom "SetupLsp: ' .. msg .. '"')
  end
end

debug_log("Starting LSP setup (Native Nvim 0.11+)")

-- 2. Global Defaults (Capabilities & Attach Logic)
local capabilities = require('cmp_nvim_lsp').default_capabilities()

-- In Nvim 0.11+, use LspAttach autocmd instead of passing on_attach to every server
vim.api.nvim_create_autocmd('LspAttach', {
  desc = 'LSP actions',
  callback = function(event)
    local client = vim.lsp.get_client_by_id(event.data.client_id)
    local buf = event.buf

    debug_log("LSP " .. client.name .. " attached to buffer " .. buf)

    -- Enable completion triggered by <c-x><c-o>
    vim.bo[buf].omnifunc = 'v:lua.vim.lsp.omnifunc'
    
    -- Enable document formatting via <leader>l
    -- (Note: formatexpr is usually set automatically by the client now, 
    -- but you can force it here if preferred)
    vim.bo[buf].formatexpr = 'v:lua.vim.lsp.formatexpr()'

    -- Keybinding for formatting
    vim.keymap.set('n', '<leader>l', function() 
      vim.lsp.buf.format({ async = true }) 
    end, { buffer = buf, desc = "Format buffer" })
  end
})

-- 3. Configuration Parser (Your existing logic, untouched)
local function get_efm_lsps()
  local efm_config_path = vim.fn.expand('~/.vim/efm-langserver-config.yaml')
  debug_log("Reading config from " .. efm_config_path)
  
  local f = io.open(efm_config_path, "r")
  if not f then
    debug_log("ERROR - Could not open " .. efm_config_path)
    return {}
  end

  local lsps = {}
  local in_tools = false
  local current_tool = nil
  local current_lsp_config = nil
  local in_root_markers = false

  for line in f:lines() do
    if line:match("^tools:") then
      in_tools = true
    elseif line:match("^%S") and not line:match("^tools:") then
      if current_lsp_config and current_lsp_config.name then
        table.insert(lsps, current_lsp_config)
      end
      in_tools = false
      current_tool = nil
      current_lsp_config = nil
      in_root_markers = false
    end

    if in_tools then
      local tool_name = line:match("^%s+(%w+):%s*&")
      if tool_name then
        if current_lsp_config and current_lsp_config.name then
          table.insert(lsps, current_lsp_config)
        end
        current_tool = tool_name
        current_lsp_config = { root_markers = {} }
        in_root_markers = false
      end
      
      if current_tool and current_lsp_config then
        local lsp_name = line:match("^%s+lspconfig_name:%s*[\"']?([%w_]+)[\"']?")
        if lsp_name then
          current_lsp_config.name = lsp_name
        end
        
        if line:match("^%s+rootMarkers:") then
          in_root_markers = true
        elseif in_root_markers then
          local marker = line:match("^%s+%-%s+[\"']?([^\"']+)[\"']?%s*$")
          if marker then
            table.insert(current_lsp_config.root_markers, marker)
          else
            in_root_markers = false
          end
        end
      end
    end
  end
  
  if current_lsp_config and current_lsp_config.name then
    table.insert(lsps, current_lsp_config)
  end
  f:close()
  return lsps
end

-- 4. Server Setup
local servers = get_efm_lsps()
local setup_servers = {}

for _, lsp_config_data in ipairs(servers) do
  local name = lsp_config_data.name
  
  if not setup_servers[name] then
    debug_log("Configuring " .. name)
    
    -- Determine root markers
    local roots = lsp_config_data.root_markers
    if #roots == 0 then
      roots = {'.git', 'package.json', 'pyproject.toml', 'go.mod'}
    end

    -- Update the configuration in Neovim's registry
    -- In Nvim 0.11, root_markers is a native option (no need for root_dir function)
    vim.lsp.config(name, {
      capabilities = capabilities,
      root_markers = roots, 
      single_file_support = true,
    })

    -- Enable the server globally
    -- This automatically sets up the FileType autocmds based on the defaults
    -- provided by nvim-lspconfig
    vim.lsp.enable(name)
    
    setup_servers[name] = true
  end
end

debug_log("Setup complete")
EOF
endfunction

autocmd VimEnter * call SetupLspBuiltin()
