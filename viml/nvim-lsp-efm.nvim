" Tool definitions live in ~/.vim/efm-langserver-config.yaml and are shared
" with the coc flow (coc-profiles/efm/coc-settings.json). Real language
" servers come from ~/.vim/lsp-servers.json; if you want those too in this
" profile, source viml/nvim-lsp-builtin.nvim as well.
lua << EOF
local efm_bin = vim.fn.exepath("efm-langserver")
if efm_bin == "" then
  efm_bin = vim.fn.expand("~") .. "/go/bin/efm-langserver"
end
local log_dir = vim.fn.stdpath("state")
vim.fn.mkdir(log_dir, "p")

-- filetypes mirror the `languages:` keys of efm-langserver-config.yaml;
-- update both together.
vim.lsp.config("efm", {
  cmd = {
    efm_bin,
    "-c", vim.fn.expand("~/.vim/efm-langserver-config.yaml"),
    "-logfile", log_dir .. "/efm-langserver.log",
  },
  filetypes = {
    "csharp", "go", "javascript", "json", "jsonc",
    "markdown", "python", "sh", "sql", "typescript",
  },
  settings = {},
  init_options = {
    documentFormatting = true,
    documentRangeFormatting = true,
    hover = true,
    documentSymbol = true,
    codeAction = true,
    completion = true,
  },
  -- push diagnostics while typing (not just on save/open)
  handlers = {
    ["textDocument/publishDiagnostics"] = vim.lsp.with(
      vim.lsp.diagnostic.on_publish_diagnostics,
      { update_in_insert = true }
    ),
  },
})

vim.api.nvim_create_autocmd("LspAttach", {
  desc = "efm keybindings",
  callback = function(event)
    vim.keymap.set("n", "<leader>l", function()
      vim.lsp.buf.format({ async = true })
    end, { buffer = event.buf, desc = "Format buffer" })
  end,
})

vim.lsp.enable("efm")
EOF
